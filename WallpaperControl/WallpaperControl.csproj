<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>WallpaperControl.ico</ApplicationIcon>

		<AssemblyName>WallpaperControl</AssemblyName>
		<Product>Wallpaper Control</Product>
		<Company>Yasmin Mahr</Company>
		<Authors>Yasmin Mahr</Authors>
		<Description>A lightweight Windows wallpaper slideshow manager with hotkeys, tray controls, history, statistics and wallpaper filtering.</Description>
		<Copyright>Copyright © 2026 Yasmin Mahr</Copyright>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>

		<Version>2.0.2</Version>
		<AssemblyVersion>2.0.2.0</AssemblyVersion>
		<FileVersion>2.0.2.0</FileVersion>

		<SatelliteResourceLanguages>en;fr;es;ja</SatelliteResourceLanguages>

		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<DebugType>embedded</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="WallpaperControl.ico" />
		<PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
		<PackageReference Include="Ical.Net" Version="5.2.3" />
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
	</ItemGroup>

<!-- The SDK adds WPF too; this WinForms application only uses Core and WinForms. -->
    <Target Name="RemoveUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
        <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup>
    </Target>
</Project>
