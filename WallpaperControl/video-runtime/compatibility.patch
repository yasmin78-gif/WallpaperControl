+extern alias WallpaperApp;
+using App = WallpaperApp::WallpaperControl;
+using Video = WallpaperApp::WallpaperControl.Video;
+using System.Diagnostics;
+using System.Reflection;
+internal static class CandidateLiveUiChecks
+{
+    [System.Runtime.InteropServices.DllImport("user32.dll")] private static extern bool SetForegroundWindow(nint hwnd);
+    [System.Runtime.InteropServices.DllImport("user32.dll")] private static extern void keybd_event(byte key,byte scan,uint flags,nuint extra);
+    private static readonly BindingFlags Fields=BindingFlags.Instance|BindingFlags.NonPublic;
+    private static T Field<T>(object obj,string name)=>(T)obj.GetType().GetField(name,Fields)!.GetValue(obj)!;
+    private static Video.MpvVideoSession Active(App.VideoWallpaperController controller)
+    {object owned=Field<object>(controller,"session");return (Video.MpvVideoSession)owned.GetType().GetProperty("Value",Fields)!.GetValue(owned)!;}
+    internal static void Run(string fixtures)
+    {
+        Exception? error=null;
+        var thread=new Thread(()=>
+        {
+            using var form=new App.MainForm();
+            form.Shown+=async(_,_)=>
+            {
+                form.Hide();
+                try { await CheckAsync(form,fixtures); }
+                catch(Exception e){error=e;}
+                finally { typeof(App.MainForm).GetField("exitRequested",Fields)!.SetValue(form,true);form.Close(); }
+            };
+            Application.Run(form);
+        });thread.SetApartmentState(ApartmentState.STA);thread.Start();thread.Join();if(error!=null)throw error;
+    }
+    private static async Task CheckAsync(App.MainForm form,string fixtures)
+    {
+        int passed=0;void Check(bool ok,string name){if(!ok)throw new Exception("FAIL "+name);passed++;Console.WriteLine("PASS "+name);}
+        async Task Until(Func<bool> predicate){var clock=Stopwatch.StartNew();while(!predicate()){if(clock.ElapsedMilliseconds>15000)throw new TimeoutException("Real application state did not settle");await Task.Delay(30);}}
+        await Until(()=>Field<App.VideoWallpaperController?>(form,"videoWallpaper")?.HasSession==true);
+        var controller=Field<App.VideoWallpaperController>(form,"videoWallpaper");
+        Check(Field<bool>(form,"servicesEnabled")&&Video.MpvClient.LiveClients==1,"Full-service MainForm starts candidate through normal video controls");
+        var sound=Field<CheckBox>(form,"videoSoundCheck");var volume=Field<TrackBar>(form,"videoVolumeSlider");var path=Field<TextBox>(form,"videoPathText");var combo=Field<ComboBox>(form,"wallpaperModeCombo");
+        sound.Checked=true;
+        foreach(int v in new[]{0,1,50,100})
+        {
+            volume.Value=v;await Active(controller).SynchronizePolicyAsync(CancellationToken.None);var state=await Active(controller).SnapshotAsync();
+            Check(state["mute"]=="no"&&Math.Abs(double.Parse(state["volume"]!,System.Globalization.CultureInfo.InvariantCulture)-Video.MpvVideoSession.MapVolume(v))<0.001,"Actual sound/volume controls reach native player: "+v);
+        }
+        sound.Checked=false;await Active(controller).SynchronizePolicyAsync(CancellationToken.None);Check((await Active(controller).SnapshotAsync())["mute"]=="yes","Actual sound switch mutes native player");
+        typeof(Button).GetMethod("OnClick",Fields)!.Invoke(Field<Button>(form,"videoPauseButton"),[EventArgs.Empty]);await Until(()=>controller.PauseReasons.HasFlag(App.VideoPauseReason.Manual));await Active(controller).SynchronizePolicyAsync(CancellationToken.None);Check((await Active(controller).SnapshotAsync())["pause"]=="yes","Actual pause button pauses native player");
+        typeof(Button).GetMethod("OnClick",Fields)!.Invoke(Field<Button>(form,"videoPauseButton"),[EventArgs.Empty]);await Until(()=>!controller.PauseReasons.HasFlag(App.VideoPauseReason.Manual));await Active(controller).SynchronizePolicyAsync(CancellationToken.None);Check((await Active(controller).SnapshotAsync())["pause"]=="no","Actual pause button resumes native player");
+        async Task Apply(string file){path.Text=Path.Combine(fixtures,file);combo.SelectedIndex=1;await (Task)typeof(App.MainForm).GetMethod("ApplyWallpaperModeAsync",Fields)!.Invoke(form,[App.WallpaperOperatingMode.VideoWallpaper])!;}
+        long old=Active(controller).Id;await Apply("switch-colors.mp4");Check(Active(controller).Id!=old&&Video.MpvClient.LiveClients==1,"Actual MainForm A to B retires old player");
+        old=Active(controller).Id;await Apply("switch-colors.mp4");Check(Active(controller).Id!=old&&Video.MpvClient.LiveClients==1,"Actual MainForm same-file reapply owns one player");
+        var a=Apply("switch-colors.mp4");var b=Apply("loop-black.mp4");var c=Apply("loop-colors.mp4");await Task.WhenAll(a,b,c);
+        Check(Field<string>(Active(controller),"file")==Path.Combine(fixtures,"loop-colors.mp4")&&Video.MpvClient.LiveClients==1&&Video.MpvVideoSession.PeakSessions<=2,"Actual rapid A/B/C keeps only latest player and max two sessions");
+        typeof(App.MainForm).GetField("pauseOnFullscreen",Fields)!.SetValue(form,true);
+        using(var cover=Process.Start(new ProcessStartInfo(Environment.ProcessPath!){UseShellExecute=false,ArgumentList={"--libmpv-test-surface","full","5"}})!)
+        {
+            await Until(()=> { cover.Refresh(); return cover.MainWindowHandle!=0; });
+            keybd_event(0x12,0,0,0); keybd_event(0x12,0,2,0);
+            bool focused=SetForegroundWindow(cover.MainWindowHandle); await Task.Delay(150);
+            Console.WriteLine($"FULLSCREEN cover=0x{cover.MainWindowHandle:X} focusRequest={focused} detected={App.FullscreenActivityDetector.GetFullscreenState()}");
+            var deadline=Stopwatch.StartNew();
+            while(!controller.PauseReasons.HasFlag(App.VideoPauseReason.Fullscreen)&&deadline.ElapsedMilliseconds<4000){await(Task)typeof(App.MainForm).GetMethod("UpdateFullscreenPauseAsync",Fields)!.Invoke(form,null)!;await Task.Delay(50);}
+            Check(controller.PauseReasons.HasFlag(App.VideoPauseReason.Fullscreen),"Full-service MainForm detects real external fullscreen and pauses");
+            await cover.WaitForExitAsync();
+        }
+        var exitClock=Stopwatch.StartNew();while(controller.PauseReasons.HasFlag(App.VideoPauseReason.Fullscreen)&&exitClock.ElapsedMilliseconds<8000){await(Task)typeof(App.MainForm).GetMethod("UpdateFullscreenPauseAsync",Fields)!.Invoke(form,null)!;await Task.Delay(100);}
+        Check(!controller.PauseReasons.HasFlag(App.VideoPauseReason.Fullscreen),"Full-service MainForm resumes after external fullscreen exits");
+        combo.SelectedIndex=0;await(Task)typeof(App.MainForm).GetMethod("ApplyWallpaperModeAsync",Fields)!.Invoke(form,[App.WallpaperOperatingMode.ImageSlideshow])!;
+        Check(!controller.HasSession&&Video.MpvClient.LiveClients==0&&Video.MpvVideoSession.LiveSessions==0,"Actual video to image retires every client/session");
+        await Apply("loop-colors.mp4");Check(controller.HasSession&&Video.MpvClient.LiveClients==1,"Actual image to video starts one candidate");
+        await controller.StopAsync();Check(Video.MpvClient.LiveClients==0&&Video.MpvVideoSession.LiveSessions==0,"Actual clean video stop leaves zero clients/sessions");
+        Console.WriteLine("LIVE-UI checks="+passed);
+    }
+}
